# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_INVOICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_INVOICE_ENVIRONMENT=production
SDKWORK_INVOICE_PROFILE_ID=cloud.production
SDKWORK_INVOICE_APPLICATION_PUBLIC_HTTP_URL=https://invoice.sdkwork.com
SDKWORK_INVOICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVOICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_CORS_ALLOWED_ORIGINS=https://invoice.sdkwork.com,https://invoice.birdcoder.com,https://invoice.dtupay.com,https://invoice.noaper.com,https://invoice.sdkwork.cn,https://invoice.birdcoder.cn,https://invoice.dtupay.cn,https://invoice.noaper.cn,https://invoice.skubc.com,https://invoice.skubc.cn,https://invoice.zowalk.com,https://invoice.zowalk.cn,https://invoice.offer86.com,https://invoice.offer86.cn,https://invoice.86offer.com,https://invoice.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
