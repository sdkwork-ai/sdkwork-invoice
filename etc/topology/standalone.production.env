# Bootstrap profile standalone.production — replace with application-specific values.
SDKWORK_INVOICE_DEPLOYMENT_PROFILE=standalone
SDKWORK_INVOICE_ENVIRONMENT=production
SDKWORK_INVOICE_PROFILE_ID=standalone.production
SDKWORK_INVOICE_APPLICATION_PUBLIC_HTTP_URL=https://invoice.sdkwork.com
SDKWORK_INVOICE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVOICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
