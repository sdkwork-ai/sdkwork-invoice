# Isolated demo environment (cloud.demo).
# Independent database schema: sdkwork_invoice_demo
# Independent Redis prefix: invoice-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_INVOICE_DEPLOYMENT_PROFILE=cloud
SDKWORK_INVOICE_ENVIRONMENT=demo
SDKWORK_INVOICE_PROFILE_ID=cloud.demo
SDKWORK_INVOICE_APPLICATION_PUBLIC_HTTP_URL=https://invoice-demo.sdkwork.com
SDKWORK_INVOICE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVOICE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://invoice-demo.sdkwork.com,http://invoice-demo.sdkwork.com,https://invoice-demo.birdcoder.com,http://invoice-demo.birdcoder.com,https://invoice-demo.dtupay.com,http://invoice-demo.dtupay.com,https://invoice-demo.noaper.com,http://invoice-demo.noaper.com,https://invoice-demo.sdkwork.cn,http://invoice-demo.sdkwork.cn,https://invoice-demo.birdcoder.cn,http://invoice-demo.birdcoder.cn,https://invoice-demo.dtupay.cn,http://invoice-demo.dtupay.cn,https://invoice-demo.noaper.cn,http://invoice-demo.noaper.cn,https://invoice-demo.skubc.com,http://invoice-demo.skubc.com,https://invoice-demo.skubc.cn,http://invoice-demo.skubc.cn,https://invoice-demo.zowalk.com,http://invoice-demo.zowalk.com,https://invoice-demo.zowalk.cn,http://invoice-demo.zowalk.cn,https://invoice-demo.offer86.com,http://invoice-demo.offer86.com,https://invoice-demo.offer86.cn,http://invoice-demo.offer86.cn,https://invoice-demo.86offer.com,http://invoice-demo.86offer.com,https://invoice-demo.86offer.cn,http://invoice-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
